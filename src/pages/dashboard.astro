---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { goalLabels } from "@/lib/goal-labels";
import { fetchWeeklyReportData } from "@/lib/fetch-weekly-report";
import { aggregateTrend } from "@/lib/weekly-report";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: goal } = supabase
  ? await supabase
      .from("body_composition_goals")
      .select("goal_type")
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle()
  : { data: null };

const { data: measurement } = supabase
  ? await supabase
      .from("body_measurements")
      .select("weight, logged_at")
      .order("logged_at", { ascending: false })
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle()
  : { data: null };

const report = supabase ? await fetchWeeklyReportData(supabase, new Date()) : null;
const trainingTrend = report ? aggregateTrend(report.volume.map((r) => r.trend)) : null;
const weightTrend = report ? (report.measurements.find((r) => r.label === "weight")?.trend ?? null) : null;
const caloriesAligned = report?.calories.aligned ?? null;

function trendSymbol(trend: "up" | "down" | "flat" | null): string {
  if (trend === "up") return "↑";
  if (trend === "down") return "↓";
  if (trend === "flat") return "→";
  return "—";
}

const tiles = [
  {
    href: "/dashboard/plans",
    icon: "🏋️",
    title: "Training plans",
    description: "Create, view, edit, and delete exercises in your plan.",
  },
  {
    href: "/dashboard/goal",
    icon: "🎯",
    title: "Body-composition goal",
    description: "Set or update whether you're losing, gaining, or maintaining.",
  },
  {
    href: "/dashboard/calories",
    icon: "🍎",
    title: "Calories",
    description: "Log calories consumed for a given day.",
  },
  {
    href: "/dashboard/measurements",
    icon: "📏",
    title: "Measurements",
    description: "Log weight and body measurements on a weekly cadence.",
  },
  {
    href: "/dashboard/report",
    icon: "📊",
    title: "Weekly report",
    description: "Compare this week's training, measurements, and calories to last week.",
  },
];
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-4xl space-y-6 py-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Dashboard
          </h1>
          <p class="mt-1 text-sm text-blue-100/70">
            Welcome, <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">This week at a glance</h2>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <p class="text-xs tracking-wide text-blue-100/60 uppercase">Goal</p>
            <p class="mt-1 font-semibold">{goal ? (goalLabels[goal.goal_type] ?? goal.goal_type) : "Not set yet"}</p>
          </div>
          <div>
            <p class="text-xs tracking-wide text-blue-100/60 uppercase">Latest measurement</p>
            <p class="mt-1 font-semibold">
              {measurement ? `${measurement.weight} kg (${measurement.logged_at})` : "Not logged yet"}
            </p>
          </div>
          <div>
            <p class="text-xs tracking-wide text-blue-100/60 uppercase">Training</p>
            <p class="mt-1 font-semibold">{trendSymbol(trainingTrend)}</p>
          </div>
          <div>
            <p class="text-xs tracking-wide text-blue-100/60 uppercase">Weight</p>
            <p class="mt-1 font-semibold">{trendSymbol(weightTrend)}</p>
          </div>
        </div>
        <p class="mt-4 text-sm text-blue-100/80">
          Calories vs goal:{" "}
          <span class="font-semibold">{caloriesAligned === null ? "—" : caloriesAligned ? "✓" : "✗"}</span>
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          tiles.map((tile) => (
            <a
              href={tile.href}
              class="block rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl transition-colors hover:bg-white/20"
            >
              <span class="text-2xl">{tile.icon}</span>
              <p class="mt-3 font-semibold">{tile.title}</p>
              <p class="mt-1 text-sm text-blue-100/70">{tile.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Layout>
