---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { goalLabels } from "@/lib/goal-labels";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: goal } = supabase
  ? await supabase
      .from("body_composition_goals")
      .select("goal_type")
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle()
  : { data: null };

const { data: measurement } = supabase
  ? await supabase
      .from("body_measurements")
      .select("weight, logged_at")
      .order("logged_at", { ascending: false })
      .order("created_at", { ascending: false })
      .limit(1)
      .maybeSingle()
  : { data: null };
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <p class="mt-4 text-sm text-blue-100/80">
        Goal: <span class="font-semibold">{goal ? (goalLabels[goal.goal_type] ?? goal.goal_type) : "Not set yet"}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/80">
        Latest measurement:{" "}
        <span class="font-semibold">
          {measurement ? `${measurement.weight} kg (${measurement.logged_at})` : "Not logged yet"}
        </span>
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/dashboard/plans"
          class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Training plans
        </a>
        <a
          href="/dashboard/goal"
          class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Body-composition goal
        </a>
        <a
          href="/dashboard/calories"
          class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Calories
        </a>
        <a
          href="/dashboard/measurements"
          class="inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Measurements
        </a>
      </div>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
