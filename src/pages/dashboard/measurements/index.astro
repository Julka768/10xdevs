---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { ServerError } from "@/components/auth/ServerError";
import { DeleteConfirmButton } from "@/components/plans/DeleteConfirmButton";

const error = Astro.url.searchParams.get("error");
const editingId = Astro.url.searchParams.get("edit");
const editingTypeId = Astro.url.searchParams.get("edit_type");
const today = new Date().toISOString().slice(0, 10);

const supabase = createClient(Astro.request.headers, Astro.cookies);

const { data: entries } = supabase
  ? await supabase
      .from("body_measurements")
      .select("id, weight, waist, chest, hips, arms, thighs, logged_at")
      .order("logged_at", { ascending: false })
      .order("created_at", { ascending: false })
  : { data: null };

const { data: customTypesData } = supabase
  ? await supabase.from("measurement_types").select("id, name").order("created_at", { ascending: true })
  : { data: null };
const customTypes = customTypesData ?? [];

const { data: valuesData } = supabase
  ? await supabase.from("measurement_values").select("measurement_id, type_id, value")
  : { data: null };

const emptyCustomValues = new Map<string, number>();
const valuesByMeasurement = new Map<string, Map<string, number>>();
for (const v of valuesData ?? []) {
  const forEntry = valuesByMeasurement.get(v.measurement_id) ?? new Map<string, number>();
  forEntry.set(v.type_id, v.value);
  valuesByMeasurement.set(v.measurement_id, forEntry);
}

const entriesByDate = new Map<string, NonNullable<typeof entries>>();
for (const entry of entries ?? []) {
  const dayEntries = entriesByDate.get(entry.logged_at) ?? [];
  dayEntries.push(entry);
  entriesByDate.set(entry.logged_at, dayEntries);
}

const circumferenceFields = [
  { key: "waist", label: "Waist" },
  { key: "chest", label: "Chest" },
  { key: "hips", label: "Hips" },
  { key: "arms", label: "Arms" },
  { key: "thighs", label: "Thighs" },
] as const;
---

<Layout title="Measurements">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-2xl space-y-6 py-8">
      <a href="/dashboard" class="text-sm text-blue-100/70 hover:underline">← Back to dashboard</a>

      <ServerError message={error} />

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">Your measurement types</h2>

        {
          customTypes.length > 0 && (
            <div class="mb-4 space-y-2">
              {customTypes.map((type) =>
                type.id === editingTypeId ? (
                  <form
                    method="POST"
                    action={`/api/measurement-types/${type.id}/update`}
                    class="flex items-end gap-3 rounded-xl border border-white/10 bg-white/5 p-3"
                  >
                    <div class="flex-1 space-y-1.5">
                      <Label htmlFor={`edit-type-name-${type.id}`}>Name</Label>
                      <Input id={`edit-type-name-${type.id}`} name="name" value={type.name} required />
                    </div>
                    <Button type="submit" variant="secondary">
                      Save
                    </Button>
                    <a href="/dashboard/measurements" class="text-sm text-blue-100/70 hover:underline">
                      Cancel
                    </a>
                  </form>
                ) : (
                  <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3">
                    <p class="font-medium">{type.name}</p>
                    <div class="flex items-center gap-3">
                      <a
                        href={`/dashboard/measurements?edit_type=${type.id}`}
                        class="text-sm text-blue-100/70 hover:underline"
                      >
                        Rename
                      </a>
                      <DeleteConfirmButton
                        client:load
                        action={`/api/measurement-types/${type.id}/delete`}
                        itemLabel={type.name}
                      />
                    </div>
                  </div>
                ),
              )}
            </div>
          )
        }

        {
          customTypes.length < 10 && (
            <form method="POST" action="/api/measurement-types" class="flex items-end gap-3">
              <div class="flex-1 space-y-1.5">
                <Label htmlFor="new-type-name">Add a measurement type</Label>
                <Input id="new-type-name" name="name" placeholder="e.g. Neck" required />
              </div>
              <Button type="submit">Add</Button>
            </form>
          )
        }
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">Log measurement</h2>

        <form method="POST" action="/api/measurements" class="flex flex-wrap items-end gap-3">
          <div class="w-24 space-y-1.5">
            <Label htmlFor="weight">Weight (kg)</Label>
            <Input id="weight" name="weight" type="number" step="0.1" min="0.1" required />
          </div>
          <div class="w-24 space-y-1.5">
            <Label htmlFor="waist">Waist (cm)</Label>
            <Input id="waist" name="waist" type="number" step="0.1" min="0.1" />
          </div>
          <div class="w-24 space-y-1.5">
            <Label htmlFor="chest">Chest (cm)</Label>
            <Input id="chest" name="chest" type="number" step="0.1" min="0.1" />
          </div>
          <div class="w-24 space-y-1.5">
            <Label htmlFor="hips">Hips (cm)</Label>
            <Input id="hips" name="hips" type="number" step="0.1" min="0.1" />
          </div>
          <div class="w-24 space-y-1.5">
            <Label htmlFor="arms">Arms (cm)</Label>
            <Input id="arms" name="arms" type="number" step="0.1" min="0.1" />
          </div>
          <div class="w-24 space-y-1.5">
            <Label htmlFor="thighs">Thighs (cm)</Label>
            <Input id="thighs" name="thighs" type="number" step="0.1" min="0.1" />
          </div>
          {
            customTypes.map((type) => (
              <div class="w-24 space-y-1.5">
                <Label htmlFor={`custom-${type.id}`}>{type.name}</Label>
                <Input id={`custom-${type.id}`} name={`custom_${type.id}`} type="number" step="0.1" min="0.1" />
              </div>
            ))
          }
          <div class="w-40 space-y-1.5">
            <Label htmlFor="logged_at">Date</Label>
            <Input id="logged_at" name="logged_at" type="date" value={today} required />
          </div>
          <Button type="submit">Log</Button>
        </form>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">History</h2>

        {
          entriesByDate.size > 0 ? (
            <div class="space-y-6">
              {[...entriesByDate.entries()].map(([date, dayEntries]) => (
                <div>
                  <h3 class="mb-2 text-sm font-semibold text-blue-100/70">{date}</h3>
                  <div class="space-y-3">
                    {dayEntries.map((entry) => {
                      const entryCustomValues = valuesByMeasurement.get(entry.id) ?? emptyCustomValues;
                      return entry.id === editingId ? (
                        <form
                          method="POST"
                          action={`/api/measurements/${entry.id}/update`}
                          class="flex flex-wrap items-end gap-3 rounded-xl border border-white/10 bg-white/5 p-3"
                        >
                          <div class="w-24 space-y-1.5">
                            <Label htmlFor={`edit-weight-${entry.id}`}>Weight (kg)</Label>
                            <Input
                              id={`edit-weight-${entry.id}`}
                              name="weight"
                              type="number"
                              step="0.1"
                              min="0.1"
                              value={entry.weight}
                              required
                            />
                          </div>
                          {circumferenceFields.map((field) => (
                            <div class="w-24 space-y-1.5">
                              <Label htmlFor={`edit-${field.key}-${entry.id}`}>{field.label} (cm)</Label>
                              <Input
                                id={`edit-${field.key}-${entry.id}`}
                                name={field.key}
                                type="number"
                                step="0.1"
                                min="0.1"
                                value={entry[field.key] ?? ""}
                              />
                            </div>
                          ))}
                          {customTypes.map((type) => (
                            <div class="w-24 space-y-1.5">
                              <Label htmlFor={`edit-custom-${type.id}-${entry.id}`}>{type.name}</Label>
                              <Input
                                id={`edit-custom-${type.id}-${entry.id}`}
                                name={`custom_${type.id}`}
                                type="number"
                                step="0.1"
                                min="0.1"
                                value={entryCustomValues.get(type.id) ?? ""}
                              />
                            </div>
                          ))}
                          <div class="w-40 space-y-1.5">
                            <Label htmlFor={`edit-date-${entry.id}`}>Date</Label>
                            <Input
                              id={`edit-date-${entry.id}`}
                              name="logged_at"
                              type="date"
                              value={entry.logged_at}
                              required
                            />
                          </div>
                          <Button type="submit" variant="secondary">
                            Save
                          </Button>
                          <a href="/dashboard/measurements" class="text-sm text-blue-100/70 hover:underline">
                            Cancel
                          </a>
                        </form>
                      ) : (
                        <div class="flex items-center justify-between rounded-xl border border-white/10 bg-white/5 p-3">
                          <div>
                            <p class="font-medium">{entry.weight} kg</p>
                            {(circumferenceFields.some((field) => entry[field.key] !== null) ||
                              customTypes.some((type) => entryCustomValues.has(type.id))) && (
                              <p class="text-sm text-blue-100/70">
                                {[
                                  ...circumferenceFields
                                    .filter((field) => entry[field.key] !== null)
                                    .map((field) => `${field.label}: ${entry[field.key]}cm`),
                                  ...customTypes
                                    .filter((type) => entryCustomValues.has(type.id))
                                    .map((type) => `${type.name}: ${entryCustomValues.get(type.id)}`),
                                ].join(" · ")}
                              </p>
                            )}
                          </div>
                          <div class="flex items-center gap-3">
                            <a
                              href={`/dashboard/measurements?edit=${entry.id}`}
                              class="text-sm text-blue-100/70 hover:underline"
                            >
                              Edit
                            </a>
                            <DeleteConfirmButton
                              client:load
                              action={`/api/measurements/${entry.id}/delete`}
                              itemLabel={`${entry.weight} kg`}
                            />
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-center text-blue-100/70">No measurements yet. Log one above to get started.</p>
          )
        }
      </div>
    </div>
  </div>
</Layout>
