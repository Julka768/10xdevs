---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { ServerError } from "@/components/auth/ServerError";
import { DeleteConfirmButton } from "@/components/plans/DeleteConfirmButton";

const { id } = Astro.params;
if (typeof id !== "string") {
  return Astro.redirect("/dashboard/plans");
}
const error = Astro.url.searchParams.get("error");
const editingId = Astro.url.searchParams.get("edit");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: plan } = supabase
  ? await supabase.from("training_plans").select("id, name").eq("id", id).maybeSingle()
  : { data: null };

if (!plan) {
  return Astro.redirect("/dashboard/plans");
}

const { data: exercises } = supabase
  ? await supabase
      .from("exercises")
      .select("id, name, target_sets, target_reps, position")
      .eq("plan_id", id)
      .order("position", { ascending: true })
  : { data: null };
---

<Layout title={plan.name}>
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-2xl space-y-6 py-8">
      <div class="flex items-center justify-between gap-4">
        <a href="/dashboard/plans" class="text-sm text-blue-100/70 hover:underline">← All plans</a>
        <a
          href={`/dashboard/plans/${plan.id}/log`}
          class="rounded-lg border border-emerald-400/40 bg-emerald-500/10 px-3 py-1.5 text-sm font-medium text-emerald-200 hover:bg-emerald-500/20"
        >
          Log workout →
        </a>
      </div>

      <ServerError message={error} />

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <div class="flex items-end justify-between gap-4">
          <form method="POST" action={`/api/plans/${plan.id}/rename`} class="flex flex-1 items-end gap-3">
            <div class="flex-1 space-y-1.5">
              <Label htmlFor="name">Plan name</Label>
              <Input id="name" name="name" defaultValue={plan.name} required />
            </div>
            <Button type="submit" variant="secondary">Rename</Button>
          </form>
          <DeleteConfirmButton client:load action={`/api/plans/${plan.id}/delete`} itemLabel={plan.name} />
        </div>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold">
          Exercises
          {
            exercises && exercises.length > 0 && (
              <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs font-medium text-blue-100/70">
                {exercises.length}
              </span>
            )
          }
        </h2>

        {
          exercises && exercises.length > 0 ? (
            <div class="space-y-3">
              {exercises.map((exercise, index) =>
                exercise.id === editingId ? (
                  <form
                    method="POST"
                    action={`/api/plans/${plan.id}/exercises/${exercise.id}/update`}
                    class="rounded-xl border border-blue-400/40 bg-blue-500/10 p-4"
                  >
                    <p class="mb-3 text-xs font-semibold tracking-wide text-blue-200 uppercase">Editing exercise</p>
                    <div class="flex flex-wrap items-end gap-3">
                      <div class="min-w-40 flex-1 space-y-1.5">
                        <Label htmlFor={`name-${exercise.id}`}>Name</Label>
                        <Input id={`name-${exercise.id}`} name="name" defaultValue={exercise.name} required />
                      </div>
                      <div class="w-24 space-y-1.5">
                        <Label htmlFor={`sets-${exercise.id}`}>Sets</Label>
                        <Input
                          id={`sets-${exercise.id}`}
                          name="target_sets"
                          type="number"
                          min="1"
                          defaultValue={exercise.target_sets}
                          required
                        />
                      </div>
                      <div class="w-28 space-y-1.5">
                        <Label htmlFor={`reps-${exercise.id}`}>Reps</Label>
                        <Input
                          id={`reps-${exercise.id}`}
                          name="target_reps"
                          type="text"
                          maxLength={20}
                          placeholder="8-10 or max"
                          defaultValue={exercise.target_reps}
                          required
                        />
                      </div>
                      <Button type="submit" variant="secondary">
                        Save
                      </Button>
                      <a href={`/dashboard/plans/${plan.id}`} class="text-sm text-blue-100/70 hover:underline">
                        Cancel
                      </a>
                    </div>
                  </form>
                ) : (
                  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 p-4 transition-colors hover:bg-white/10">
                    <div class="min-w-0">
                      <p class="truncate font-medium">{exercise.name}</p>
                      <div class="mt-1.5 flex items-center gap-2">
                        <span class="rounded-full bg-blue-500/20 px-2 py-0.5 text-xs font-medium text-blue-100">
                          {exercise.target_sets} sets
                        </span>
                        <span class="rounded-full bg-purple-500/20 px-2 py-0.5 text-xs font-medium text-purple-100">
                          {exercise.target_reps} reps
                        </span>
                      </div>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                      <div class="flex items-center gap-1">
                        <form method="POST" action={`/api/plans/${plan.id}/exercises/${exercise.id}/move`}>
                          <input type="hidden" name="direction" value="up" />
                          <button
                            type="submit"
                            disabled={index === 0}
                            aria-label="Move up"
                            class="rounded-lg border border-white/20 px-2 py-1.5 text-blue-100/80 hover:bg-white/10 hover:text-white disabled:pointer-events-none disabled:opacity-30"
                          >
                            ↑
                          </button>
                        </form>
                        <form method="POST" action={`/api/plans/${plan.id}/exercises/${exercise.id}/move`}>
                          <input type="hidden" name="direction" value="down" />
                          <button
                            type="submit"
                            disabled={index === exercises.length - 1}
                            aria-label="Move down"
                            class="rounded-lg border border-white/20 px-2 py-1.5 text-blue-100/80 hover:bg-white/10 hover:text-white disabled:pointer-events-none disabled:opacity-30"
                          >
                            ↓
                          </button>
                        </form>
                      </div>
                      <a
                        href={`/dashboard/plans/${plan.id}?edit=${exercise.id}`}
                        class="rounded-lg border border-white/20 px-3 py-1.5 text-sm text-blue-100/80 hover:bg-white/10 hover:text-white"
                      >
                        Edit
                      </a>
                      <DeleteConfirmButton
                        client:load
                        action={`/api/plans/${plan.id}/exercises/${exercise.id}/delete`}
                        itemLabel={exercise.name}
                      />
                    </div>
                  </div>
                ),
              )}
            </div>
          ) : (
            <p class="mb-4 text-center text-blue-100/70">No exercises yet. Add your first one below.</p>
          )
        }

        <div class="mt-4 border-t border-white/10 pt-4">
          <p class="mb-3 text-xs font-semibold tracking-wide text-blue-100/60 uppercase">Add exercise</p>
          <form method="POST" action={`/api/plans/${plan.id}/exercises`} class="flex flex-wrap items-end gap-3">
            <div class="min-w-40 flex-1 space-y-1.5">
              <Label htmlFor="new-name">Exercise name</Label>
              <Input id="new-name" name="name" placeholder="e.g. Bench press" required />
            </div>
            <div class="w-24 space-y-1.5">
              <Label htmlFor="new-sets">Sets</Label>
              <Input id="new-sets" name="target_sets" type="number" min="1" placeholder="3" required />
            </div>
            <div class="w-28 space-y-1.5">
              <Label htmlFor="new-reps">Reps</Label>
              <Input id="new-reps" name="target_reps" type="text" maxLength={20} placeholder="8-10 or max" required />
            </div>
            <Button type="submit">Add</Button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>
