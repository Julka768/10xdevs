---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Button } from "@/components/ui/button";
import { ServerError } from "@/components/auth/ServerError";
import { DeleteConfirmButton } from "@/components/plans/DeleteConfirmButton";

const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: plans } = supabase
  ? await supabase.from("training_plans").select("id, name").order("created_at", { ascending: false })
  : { data: null };

const { data: exerciseRows } = supabase ? await supabase.from("exercises").select("plan_id") : { data: null };
const exerciseCountByPlan = new Map<string, number>();
for (const row of exerciseRows ?? []) {
  exerciseCountByPlan.set(row.plan_id, (exerciseCountByPlan.get(row.plan_id) ?? 0) + 1);
}
---

<Layout title="Training plans">
  <div class="bg-cosmic min-h-screen p-4 text-white">
    <div class="mx-auto max-w-2xl space-y-6 py-8">
      <div class="flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Training plans
        </h1>
        <a href="/dashboard" class="text-sm text-blue-100/70 hover:underline">Back to dashboard</a>
      </div>

      <ServerError message={error} />

      <div class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <form method="POST" action="/api/plans" class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="flex-1 space-y-1.5">
            <Label htmlFor="name">Plan name</Label>
            <Input id="name" name="name" placeholder="e.g. Push Pull Legs" required />
          </div>
          <Button type="submit" className="sm:w-auto"> Create </Button>
        </form>
      </div>

      {
        plans && plans.length > 0 ? (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {plans.map((plan) => {
              const count = exerciseCountByPlan.get(plan.id) ?? 0;
              return (
                <div class="relative rounded-2xl border border-white/10 bg-white/10 p-6 pr-14 backdrop-blur-xl">
                  <span class="text-2xl">🏋️</span>
                  <p class="mt-3 truncate font-semibold">{plan.name}</p>
                  <p class="mt-1 text-sm text-blue-100/70">
                    {count} exercise{count === 1 ? "" : "s"}
                  </p>
                  <div class="mt-4 flex items-center gap-2">
                    <a
                      href={`/dashboard/plans/${plan.id}`}
                      class="flex-1 rounded-lg border border-white/20 px-3 py-1.5 text-center text-sm font-medium text-blue-100/80 hover:bg-white/10 hover:text-white"
                    >
                      Edit
                    </a>
                    <a
                      href={`/dashboard/plans/${plan.id}/log`}
                      class="flex-1 rounded-lg border border-emerald-400/40 bg-emerald-500/10 px-3 py-1.5 text-center text-sm font-medium text-emerald-200 hover:bg-emerald-500/20"
                    >
                      Log
                    </a>
                  </div>
                  <div class="absolute top-4 right-4">
                    <DeleteConfirmButton client:load action={`/api/plans/${plan.id}/delete`} itemLabel={plan.name} />
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="rounded-2xl border border-dashed border-white/20 p-10 text-center text-blue-100/70">
            You don't have any training plans yet. Create your first one above.
          </div>
        )
      }
    </div>
  </div>
</Layout>
